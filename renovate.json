{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>glockyco/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["dotnet-version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "dotnet-version",
      "depNameTemplate": "dotnet-sdk"
    }
  ],
  "packageRules": [
    {
      "description": "TypeScript 7 awaits Svelte Check and typescript-eslint support",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}

# Copy to .env and fill in local machine paths. Do not commit .env.

# Ardenfall Demo install paths.
ARDENFALL_MANAGED_DIR="/Users/<you>/Library/Application Support/CrossOver/Bottles/Steam/drive_c/Program Files (x86)/Steam/steamapps/common/Ardenfall Demo/Ardenfall_Data/Managed"
ARDENFALL_PLUGINS_DIR="/Users/<you>/Library/Application Support/CrossOver/Bottles/Steam/drive_c/Program Files (x86)/Steam/steamapps/common/Ardenfall Demo/BepInEx/plugins"

# HotRepl checkout and build outputs.
HOTREPL_REPO="/Users/<you>/Projects/HotRepl"
HOTREPL_CORE_OUT="/Users/<you>/Projects/HotRepl/src/HotRepl.Core/bin/Debug/netstandard2.1"
HOTREPL_BEPINEX_OUT="/Users/<you>/Projects/HotRepl/src/HotRepl.BepInEx/bin/Debug/netstandard2.1"

# Ardenfall Compendium mod output.
ARDENFALL_MOD_OUT="./mod/bin/Debug/netstandard2.1"

# Runtime HotRepl connection.
HOTREPL_BIND_HOST="0.0.0.0"
HOTREPL_URL="ws://127.0.0.1:18590"
HOTREPL_TOKEN="replace-with-random-output-from-openssl-rand-hex-24"

# Controller output paths.
ARDENFALL_SNAPSHOT_OUT="./snapshots"
ARDENFALL_PIPELINE_OUT="./pipeline/dist"

# Optional launch hook for `bun run hotrepl:launch`.
# Example: open 'steam://rungameid/<steam-app-id>'
ARDENFALL_LAUNCH_COMMAND=""

{
  "$schema": "../../schemas/entity.schema.json",
  "id": "status-effect",
  "kind": "definition",
  "label": { "singular": "Status Effect", "plural": "Status Effects" },
  "extraction": {
    "source": "lookupAsset",
    "root": "BuiltLookupTable.GetAssetsOfType<StatusEffectData>",
    "walker": "StatusEffectExtractor"
  },
  "canonicalTable": "status_effects",
  "presentationContext": { "renderContext": "status-effect-presentation-v1" },
  "site": {
    "route": "/status-effects"
  },
  "fields": [
    { "name": "id", "type": "id", "from": "guid", "missingPolicy": "fatal" },
    {
      "name": "statusEffectName",
      "type": "string",
      "from": "statusEffectName",
      "missingPolicy": "diagnostic",
      "column": "status_effect_name"
    },
    {
      "name": "tooltipSource",
      "type": "string",
      "from": "tooltip.GetTooltip(1f, 1f, false, effect)",
      "missingPolicy": "optional-empty",
      "column": "tooltip_source"
    },
    {
      "name": "iconRef",
      "type": "ref:asset",
      "from": "statusEffectIcon",
      "missingPolicy": "optional-empty",
      "column": "icon_ref_json"
    },
    {
      "name": "isHostile",
      "type": "boolean",
      "from": "isHostile",
      "missingPolicy": "optional-empty",
      "column": "is_hostile"
    }
  ],
  "map": null
}

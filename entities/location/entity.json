{
  "$schema": "../../schemas/entity.schema.json",
  "id": "location",
  "kind": "definition",
  "label": {
    "singular": "Location",
    "plural": "Locations"
  },
  "extraction": {
    "source": "lookupAsset",
    "root": "MapLocationManager.GetLocations",
    "walker": "LocationWalker"
  },
  "canonicalTable": "locations",
  "placement": { "kind": "point+volume", "from": "fields" },
  "fields": [
    { "name": "id", "type": "id", "from": "guid", "missingPolicy": "fatal" },
    { "name": "name", "type": "string", "from": "locationName", "missingPolicy": "fatal" },
    { "name": "enabled", "type": "boolean", "from": "enabled", "missingPolicy": "fatal" },
    {
      "name": "mapId",
      "type": "string",
      "from": "map.id",
      "missingPolicy": "diagnostic",
      "column": "map_id"
    },
    {
      "name": "mapRef",
      "type": "ref:asset",
      "from": "mapRef",
      "column": "map_ref_json"
    },
    {
      "name": "showOnMap",
      "type": "boolean",
      "from": "showOnMap",
      "missingPolicy": "fatal",
      "column": "show_on_map"
    },
    {
      "name": "iconRef",
      "type": "ref:asset",
      "from": "iconRef",
      "column": "icon_ref_json"
    },
    {
      "name": "mapPosition",
      "type": "json",
      "from": "mapPosition",
      "column": "source_map_position_json",
      "projects": "map_points"
    },
    {
      "name": "showOnMapDebugOnly",
      "type": "boolean",
      "from": "showOnMapDebugOnly",
      "missingPolicy": "fatal",
      "column": "show_on_map_debug_only",
      "label": "Debug-only map marker"
    },
    {
      "name": "allowFastTravel",
      "type": "boolean",
      "from": "allowFastTravel",
      "missingPolicy": "fatal",
      "label": "Allows fast travel",
      "column": "allow_fast_travel"
    },
    {
      "name": "fastTravelPosition",
      "type": "json",
      "from": "fastTravelPosition",
      "column": "source_fast_travel_json"
    },
    {
      "name": "volumes",
      "type": "json",
      "from": "volumes",
      "storage": "unstored",
      "reason": "Expanded into location_volumes rows.",
      "projects": "location_volumes"
    }
  ],
  "map": {
    "layer": "locations",
    "renderKind": "point-or-polygon",
    "icon": "location",
    "color": [120, 170, 255],
    "radius": 6,
    "tooltip": ["name"],
    "legendLabel": "Locations",
    "zOrder": 100
  }
}

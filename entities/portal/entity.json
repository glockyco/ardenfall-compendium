{
  "$schema": "../../schemas/entity.schema.json",
  "id": "portal",
  "kind": "instance",
  "label": { "singular": "Portal", "plural": "Portals" },
  "extraction": {
    "source": "record",
    "root": "Ardenfall.RecordSystem.PortalRecord",
    "options": { "table": "world", "subtable": "portals" }
  },
  "canonicalTable": "portals",
  "placement": { "kind": "point", "from": "transform" },
  "fields": [
    { "name": "id", "type": "id", "from": "recordId", "missingPolicy": "fatal" },
    {
      "name": "recordRef",
      "type": "ref:record",
      "from": "recordRef",
      "column": "record_ref_json"
    },
    {
      "name": "friendlyName",
      "type": "string",
      "from": "friendlyName",
      "column": "friendly_name",
      "missingPolicy": "diagnostic"
    },
    {
      "name": "position",
      "type": "json",
      "from": "position",
      "column": "source_position_json",
      "projects": "map_points"
    },
    {
      "name": "mapId",
      "type": "string",
      "from": "transform.mapID",
      "missingPolicy": "diagnostic",
      "column": "map_id"
    },
    {
      "name": "connectedPortalRef",
      "type": "ref:record",
      "from": "connectedPortal",
      "missingPolicy": "diagnostic",
      "column": "connected_portal_ref_json"
    }
  ],
  "map": {
    "layer": "portals",
    "renderKind": "point",
    "icon": "portal",
    "color": [190, 150, 255],
    "radius": 5,
    "tooltip": ["friendlyName"],
    "legendLabel": "Portals",
    "zOrder": 90
  }
}

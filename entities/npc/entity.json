{
  "$schema": "../../schemas/entity.schema.json",
  "id": "npc",
  "kind": "instance",
  "label": {
    "singular": "Character",
    "plural": "Characters"
  },
  "extraction": {
    "source": "record",
    "file": "npcs.json",
    "root": "Ardenfall.RecordSystem.NPCRecord",
    "options": {
      "table": "instances",
      "subtable": "characters"
    }
  },
  "canonicalTable": "npcs",
  "naming": {
    "displayName": {
      "from": "StoredCharacterData.charName.Get()?.name",
      "policy": "player-visible"
    },
    "authoringLabel": {
      "from": "customFriendlyID",
      "policy": "designer-identifier"
    }
  },
  "presentationContext": { "renderContext": "character-presentation-v1" },
  "site": {
    "route": "/characters",
    "overview": { "columns": ["displayName"], "search": ["displayName"] },
    "detail": {
      "sections": [
        {
          "id": "overview",
          "kind": "fieldList",
          "title": "Overview",
          "fields": ["displayName", "mapId", "spawnPoint", "containingLocationRefs"]
        }
      ]
    }
  },
  "placement": {
    "kind": "point",
    "from": "spawnPoint"
  },
  "fields": [
    {
      "name": "id",
      "type": "id",
      "from": "recordId",
      "missingPolicy": "fatal"
    },
    {
      "name": "recordRef",
      "type": "ref:record",
      "from": "recordRef",
      "column": "record_ref_json"
    },
    {
      "name": "displayName",
      "type": "string",
      "from": "displayName",
      "missingPolicy": "diagnostic",
      "column": "display_name"
    },
    {
      "name": "displayNameProvenance",
      "type": "string",
      "from": "displayNameProvenance",
      "missingPolicy": "fatal",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "displayNameOwner",
      "type": "string",
      "from": "displayNameOwner",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "authoringLabel",
      "type": "string",
      "from": "authoringLabel",
      "missingPolicy": "optional-empty",
      "column": "authoring_label"
    },
    {
      "name": "characterRef",
      "type": "ref:asset",
      "from": "characterRef",
      "missingPolicy": "optional-empty",
      "column": "character_ref_json"
    },
    {
      "name": "spawnPoint",
      "type": "json",
      "from": "spawnPoint.position",
      "column": "source_spawn_point_json",
      "projects": "map_points"
    },
    {
      "name": "mapId",
      "type": "string",
      "from": "spawnPoint.map.id",
      "missingPolicy": "diagnostic",
      "column": "map_id"
    },
    {
      "name": "containingLocationRefs",
      "type": "ref:asset[]",
      "from": "containingLocations",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Expanded into npc_location_refs rows. The mod runs LocationAsset.IsInside because containment is game logic, and a location holds several volumes that stored bounds cannot reproduce.",
      "projects": "npc_location_refs"
    },
    {
      "name": "dropRefs",
      "type": "ref:asset[]",
      "from": "dropRefs",
      "missingPolicy": "optional-empty",
      "column": "drop_refs_json"
    },
    {
      "name": "dropRefsProvenance",
      "type": "string",
      "from": "dropRefsProvenance",
      "missingPolicy": "fatal",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "dropRefsOwner",
      "type": "string",
      "from": "dropRefsOwner",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "startingFactions",
      "type": "ref:asset[]",
      "from": "startingFactions",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Expanded into npc_faction_refs rows.",
      "projects": "npc_faction_refs"
    },
    {
      "name": "startingFactionsProvenance",
      "type": "string",
      "from": "startingFactionsProvenance",
      "missingPolicy": "fatal",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "startingFactionsOwner",
      "type": "string",
      "from": "startingFactionsOwner",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "startingLevel",
      "type": "json",
      "from": "startingLevel",
      "missingPolicy": "optional-empty",
      "column": "starting_level_json"
    },
    {
      "name": "startingLevelProvenance",
      "type": "string",
      "from": "startingLevelProvenance",
      "missingPolicy": "fatal",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "startingLevelOwner",
      "type": "string",
      "from": "startingLevelOwner",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "merchantRefs",
      "type": "ref:asset[]",
      "from": "merchantRefs",
      "missingPolicy": "optional-empty",
      "column": "merchant_refs_json"
    },
    {
      "name": "merchantRefsProvenance",
      "type": "string",
      "from": "merchantRefsProvenance",
      "missingPolicy": "fatal",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "merchantRefsOwner",
      "type": "string",
      "from": "merchantRefsOwner",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "merchantGold",
      "type": "ref:asset",
      "from": "merchantGold",
      "missingPolicy": "optional-empty",
      "column": "merchant_gold_json"
    },
    {
      "name": "merchantGoldProvenance",
      "type": "string",
      "from": "merchantGoldProvenance",
      "missingPolicy": "fatal",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "merchantGoldOwner",
      "type": "string",
      "from": "merchantGoldOwner",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "merchantCategories",
      "type": "ref:asset[]",
      "from": "merchantCategories",
      "missingPolicy": "optional-empty",
      "column": "merchant_categories_json"
    },
    {
      "name": "merchantCategoriesProvenance",
      "type": "string",
      "from": "merchantCategoriesProvenance",
      "missingPolicy": "fatal",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    },
    {
      "name": "merchantCategoriesOwner",
      "type": "string",
      "from": "merchantCategoriesOwner",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Normalised into npc_value_provenance rather than repeated as a canonical column.",
      "projects": "npc_value_provenance"
    }
  ],
  "map": {
    "layer": "npcs",
    "renderKind": "point",
    "icon": "character",
    "color": [255, 200, 120],
    "radius": 4,
    "tooltip": ["displayName"],
    "legendLabel": "Characters",
    "zOrder": 80
  }
}

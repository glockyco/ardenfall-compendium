{
  "$schema": "../../schemas/entity.schema.json",
  "id": "dialogue",
  "kind": "instance",
  "label": {
    "singular": "Conversation",
    "plural": "Conversations"
  },
  "extraction": {
    "source": "scene",
    "file": "dialogues.json",
    "root": "Ardenfall.Dialog.DialogFlowGraph",
    "options": {
      "holders": "CharacterData,CharacterModule,CharacterQuestObject,CharacterGroupQuestObject,SimpleDialogSceneQuestObject,SimpleDialogInteractable"
    }
  },
  "canonicalTable": "dialogues",
  "presentationContext": {
    "renderContext": "dialogue-presentation-v1"
  },
  "site": {
    "route": "/conversations",
    "overview": {
      "columns": ["graphName"],
      "search": ["graphName"]
    },
    "detail": {
      "sections": [
        {
          "id": "overview",
          "kind": "fieldList",
          "title": "Overview",
          "fields": ["graphName", "holders", "nodes"]
        }
      ]
    }
  },
  "fields": [
    {
      "name": "id",
      "type": "id",
      "from": "id",
      "missingPolicy": "fatal"
    },
    {
      "name": "graphName",
      "type": "string",
      "from": "graphName",
      "column": "graph_name",
      "missingPolicy": "fatal"
    },
    {
      "name": "nodes",
      "type": "json",
      "from": "nodes",
      "column": "nodes_json",
      "missingPolicy": "fatal"
    },
    {
      "name": "edges",
      "type": "json",
      "from": "edges",
      "column": "edges_json",
      "missingPolicy": "fatal"
    },
    {
      "name": "entryNodes",
      "type": "json",
      "from": "entryNodes",
      "column": "entry_nodes_json",
      "missingPolicy": "diagnostic"
    },
    {
      "name": "holders",
      "type": "json",
      "from": "holders",
      "column": "holders_json",
      "missingPolicy": "diagnostic"
    }
  ]
}

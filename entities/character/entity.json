{
  "$schema": "../../schemas/entity.schema.json",
  "id": "character",
  "kind": "definition",
  "label": { "singular": "Character", "plural": "Characters" },
  "extraction": {
    "source": "namedAsset",
    "root": "Resources.FindObjectsOfTypeAll<CharacterData>",
    "walker": "CharacterExtractor"
  },
  "canonicalTable": "characters",
  "naming": {
    "displayName": {
      "from": "charName.Get()?.name",
      "policy": "player-visible"
    }
  },
  "presentationContext": { "renderContext": "character-presentation-v1" },
  "site": {
    "route": "/characters",
    "overview": { "columns": ["name"], "search": ["name"] },
    "detail": {
      "sections": [
        { "id": "overview", "kind": "fieldList", "title": "Overview", "fields": ["name"] }
      ]
    }
  },
  "fields": [
    { "name": "id", "type": "id", "from": "id", "missingPolicy": "fatal" },
    {
      "name": "parentRef",
      "type": "ref:asset",
      "from": "parentRef",
      "column": "parent_ref_json",
      "missingPolicy": "optional-empty"
    },
    {
      "name": "raceRef",
      "type": "ref:asset",
      "from": "raceRef",
      "column": "race_ref_json",
      "missingPolicy": "diagnostic"
    },
    {
      "name": "name",
      "type": "string",
      "from": "charName.Get()?.name",
      "missingPolicy": "diagnostic",
      "column": "character_name"
    },
    {
      "name": "dropRefs",
      "type": "ref:asset[]",
      "from": "itemLists + additionalItems",
      "missingPolicy": "optional-empty",
      "column": "drop_refs_json"
    },
    {
      "name": "startingFactions",
      "type": "ref:asset[]",
      "from": "startingFactions",
      "missingPolicy": "optional-empty",
      "storage": "unstored",
      "reason": "Expanded into character_faction_refs rows.",
      "projects": "character_faction_refs"
    }
  ],
  "map": null
}

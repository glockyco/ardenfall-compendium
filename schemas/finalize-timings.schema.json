{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ardenfall-compendium.example/schemas/finalize-timings.schema.json",
  "title": "Run finalize timings artifact",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["phase", "elapsedMs", "totalElapsedMs"],
    "properties": {
      "phase": { "type": "string", "minLength": 1 },
      "elapsedMs": { "type": "integer", "minimum": 0 },
      "totalElapsedMs": { "type": "integer", "minimum": 0 }
    }
  }
}

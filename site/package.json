{
  "name": "@ardenfall-compendium/site",
  "version": "0.0.0",
  "devDependencies": {
    "@deck.gl/core": "^9.3",
    "@deck.gl/layers": "^9.3",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.8",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.11",
    "wrangler": "^4.90.1"
  },
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "bun run build:fixture",
    "build:prepared": "vite build",
    "build:fixture": "bun run stage:artifact ../pipeline/artifacts/fixtures/synthetic --mode fixture && bun run build:prepared",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "smoke:error-route": "bun run scripts/smoke-error-route.mjs",
    "smoke:item-icons": "bun run scripts/smoke-item-icons.mjs",
    "smoke:prerender": "bun run scripts/smoke-prerender-output.mjs",
    "smoke:map": "bun run scripts/smoke-map-route.mjs",
    "smoke:map:browser": "bun run scripts/smoke-map-browser.mjs",
    "sync:generated": "bun run scripts/sync-generated-artifacts.mjs",
    "stage:artifact": "bun run scripts/stage-artifact.mjs",
    "deploy:production": "bun run scripts/deploy-production.mjs",
    "cf-deploy": "bun run deploy:production"
  },
  "type": "module"
}

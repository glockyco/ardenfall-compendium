{
  "name": "@ardenfall-compendium/site",
  "version": "0.0.0",
  "devDependencies": {
    "@deck.gl/core": "^9.3.7",
    "@deck.gl/layers": "^9.3.7",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.28.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.2",
    "clsx": "^2.1.1",
    "pagefind": "^1.5.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "bun run build:prepared",
    "build:prepared": "vite build && bun run build:pagefind",
    "build:fixture": "bun run stage:artifact ../pipeline/artifacts/fixtures/synthetic --mode fixture && bun run build:prepared",
    "build:pagefind": "bun run scripts/build-pagefind.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "smoke:error-route": "bun run scripts/smoke-error-route.ts",
    "smoke:prerender": "bun run scripts/smoke-prerender-output.ts",
    "smoke:pagefind": "bun run scripts/smoke-pagefind.ts",
    "smoke:map": "bun run scripts/smoke-map-route.ts",
    "smoke:accessibility": "bun run scripts/smoke-accessibility.ts",
    "stage:artifact": "bun run scripts/stage-artifact.ts",
    "deploy:production": "bun run scripts/deploy-production.ts"
  },
  "type": "module"
}

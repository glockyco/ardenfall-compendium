# Worktrees (local development isolation, never committed)
.worktrees/
worktrees/

# Decompiled third-party game sources (local analysis only; never committed)
.decompiled/

# Bun + Node
node_modules/
.bun/
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*


# SvelteKit
.svelte-kit/
site/build/
site/.wrangler/

# Pipeline outputs
pipeline/dist/*.mjs.tmp
pipeline/artifacts/
site/.data/data.sqlite
site/static/_release.json
site/_redirects
site/.data/data.sqlite-wal
site/.data/data.sqlite-shm
site/static/assets/
site/static/tiles/

# C# / BepInEx mod
mod/bin/
mod/obj/
mod/libs/

# Snapshots and ad-hoc
snapshots/
fixtures/real-capsule/snapshot/
*.log
*.tmp
*.bak

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Pipeline generated validators — the .mjs are committed; everything else under dist/ is ignored
pipeline/dist/*
!pipeline/dist/.gitkeep
!pipeline/dist/validate-*.mjs
!pipeline/dist/validate-*.d.mts
# Generated from descriptors by codegen:entity-fields and gated by check:entity-fields,
# so it has to be tracked. Without this negation the files stay ignored-but-tracked and a
# regenerate after a delete would silently not be staged.
!pipeline/dist/entity-fields.mjs
!pipeline/dist/entity-fields.d.mts
